generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 url      = env("DATABASE_URL")
}

model Order {
  id          String   @id @default(cuid())
  orderId     String   @unique @map("order_id")
  amount      Int
  currency    String   @default("INR")
  customerId  String   @map("customer_id")
  platformFee Int      @default(0) @map("platform_fee")
  tds         Int      @default(0)
  refund      Int      @default(0)
  status      String   @default("paid")
   sellerId     String  @default("unknown") @map("seller_id")
  sellerType   String  @default("unknown") @map("seller_type")
  createdAt   DateTime @default(now()) @map("created_at")
    panAvailable Boolean @default(true) @map("pan_available")
   uploadBatchId String?      @map("upload_batch_id")   // ← ADD THIS
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])  // ← ADD THIS
  gstFilings GSTFiling[]
  transfers   RouteTransfer[]
  reconciliations Reconciliation[]
  
  @@map("orders")
}
model BankSettlement {
  id             String    @id @default(cuid())
  utr            String    @unique
  transferId     String    @map("transfer_id")
  transfer       RouteTransfer @relation(fields: [transferId], references: [transferId])
  amountCredited Int       @map("amount_credited")
  creditedAt     DateTime? @map("credited_at")
  status         String    @default("pending")
  uploadBatchId  String?   @map("upload_batch_id")
  uploadBatch    UploadBatch? @relation(fields: [uploadBatchId], references: [id])
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("bank_settlements")
}

model GSTFiling {
  id            String   @id @default(cuid())
  vendorGSTIN   String   @map("vendor_gstin")
  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [orderId])
  tcsReported   Int      @map("tcs_reported")
  filingPeriod  String   @map("filing_period")
  filedAt       DateTime? @map("filed_at")
  status        String   @default("pending")
  uploadBatchId String?  @map("upload_batch_id")
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])

  @@map("gst_filings")
}
model Company {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
   user         User?
  createdAt   DateTime @default(now()) @map("created_at")

  uploadBatches UploadBatch[]

  @@map("companies")
}

model UploadBatch {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id])
  fileName    String   @map("file_name")
  orderCount  Int      @default(0) @map("order_count")
  status      String   @default("uploaded") // uploaded, reconciled
  createdAt   DateTime @default(now()) @map("created_at")
bankSettlements BankSettlement[]
  gstFilings      GSTFiling[]
  orders          Order[]
  reconciliations Reconciliation[]

  @@map("upload_batches")
}
model RouteTransfer {
  id                    String   @id @default(cuid())
  transferId            String   @unique @map("transfer_id")
  entity                String   @default("transfer")
  source                String
  order                 Order    @relation(fields: [source], references: [orderId])
  recipient             String
  amount                Int
  currency              String   @default("INR")
  amountReversed        Int      @default(0) @map("amount_reversed")
  onHold                Boolean  @default(false) @map("on_hold")
  onHoldUntil           Int?     @map("on_hold_until")
  recipientSettlementId String?  @map("recipient_settlement_id")
  settlementStatus      String   @default("pending") @map("settlement_status")
  fee                   Int      @default(0)
  tax                   Int      @default(0)
  notes                 Json     @default("{}")
  errorDescription      String?  @map("error_description")
  createdAt             Int      @map("created_at")
 bankSettlements       BankSettlement[]
  reconciliations Reconciliation[]
  
  @@map("route_transfers")
}

model Reconciliation {
  id                  String   @id @default(cuid())
  batchId             String   @map("batch_id")
  orderId             String   @map("order_id")
  order               Order    @relation(fields: [orderId], references: [orderId])
  transferId          String?  @map("transfer_id")
  transfer            RouteTransfer? @relation(fields: [transferId], references: [transferId])
   uploadBatchId String?      @map("upload_batch_id")   // ← ADD THIS
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id])  // ← ADD THIS

  customerPaid        Int      @map("customer_paid")
  routeSplit          Int      @map("route_split")
  platformFee         Int      @default(0) @map("platform_fee")
  tdsDeducted         Int      @default(0) @map("tds_deducted")
  chargebackHold      Int      @default(0) @map("chargeback_hold")
  refundAmount        Int      @default(0) @map("refund_amount")
  finalSettled        Int      @default(0) @map("final_settled")
  fee                 Int      @default(0)
  tax                 Int      @default(0)
  
  status              String   @default("pending")
  matchConfidence     Float    @default(0) @map("match_confidence")
  
  aiExplanation       String?  @map("ai_explanation")
  discrepancyCategory String?  @map("discrepancy_category")
  confidenceScore     Float?   @map("confidence_score")
  
  resolvedBy          String?  @map("resolved_by")
  resolutionAction    String?  @map("resolution_action")
  createdAt           DateTime @default(now()) @map("created_at")
  resolvedAt          DateTime? @map("resolved_at")
  
  exceptions  Exception[]
  auditLogs   AuditLog[]
  
  @@map("reconciliations")
}

model Exception {
  id                String   @id @default(cuid())
  reconciliationId  String   @map("reconciliation_id")
  reconciliation    Reconciliation @relation(fields: [reconciliationId], references: [id])
  
  category          String
  description       String
  aiExplanation     String   @map("ai_explanation")
  confidenceScore   Float    @map("confidence_score")
  amountDiscrepancy Int      @map("amount_discrepancy")

  taxLineBreakdown Json? @map("tax_line_breakdown")

  status            String   @default("open")
  createdAt         DateTime @default(now()) @map("created_at")
  resolvedAt        DateTime? @map("resolved_at")
  
  @@map("exceptions")
}

model AuditLog {
  id                String   @id @default(cuid())
  reconciliationId  String   @map("reconciliation_id")
  reconciliation    Reconciliation @relation(fields: [reconciliationId], references: [id])
  
  action            String
  actor             String   @default("system")
  details           Json
  createdAt         DateTime @default(now()) @map("created_at")
  
  @@map("audit_logs")
}
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  company       Company?  @relation(fields: [companyId], references: [id])
  companyId     String?   @unique
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
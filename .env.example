# ============================================
# ReconAI — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Database (PostgreSQL / Neon) ──────────────
DATABASE_URL="postgresql://user:password@host:5432/reconai?sslmode=require"

# ── NextAuth.js ───────────────────────────────
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── AI — OpenRouter (for explanations & chat) ─
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxx"

# ── AI — HuggingFace (for embeddings / RAG) ──
HUGGINGFACE_API_KEY="hf_xxxxxxxxxxxx"

# ── Razorpay (TEST MODE ONLY) ─────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ── Encryption (for storing Razorpay credentials) ─
ENCRYPTION_SECRET="any-random-32-char-string-here"
